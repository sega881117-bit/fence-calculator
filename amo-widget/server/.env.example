# Для локальной проверки. Не добавляйте настоящий токен amoCRM или Avito.
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGIN=https://example.amocrm.ru

# Пока значение не задано, POST /v1/drafts намеренно отвечает 503.
# В production авторизация должна быть реализована через OAuth-сессию приватного виджета,
# а не через секрет, который может увидеть браузер.
WIDGET_SERVER_ENABLED=false
